{
  "manifest_version": 3,
  "name": "Valuta Casa — Roma vs OMI",
  "version": "2.0.0",
  "description": "Su un annuncio immobiliare, un click: estrae prezzo/mq/zona/foto e chiede a Claude se è un buon affare vs OMI.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.idealista.it/*",
    "https://www.immobiliare.it/*",
    "https://www.casa.it/*",
    "https://www.subito.it/*",
    "https://*.idealista.it/*",
    "https://*.immobiliare.it/*"
  ],
  "action": {
    "default_title": "Valuta questo immobile"
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
